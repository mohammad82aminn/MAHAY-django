# Copy this file to .env and fill in real values. Never commit .env.

# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only. Addresses of your own nginx; leave empty in development.
# Without this the login IP limit can be bypassed with a forged X-Forwarded-For header.
TRUSTED_PROXIES=
# The https addresses the site is served from, e.g. https://mahay.ir
CSRF_TRUSTED_ORIGINS=
# Set to 0 for the first deploys; raise it once HTTPS is confirmed working (default: 1 year).
# Leave commented out to keep the default; an empty value here is not a number and breaks startup.
# SECURE_HSTS_SECONDS=0

DB_NAME=mahay_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (optional in development; emails are printed in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MAHAY <noreply@mahay.local>
# Production: who gets an email with the details when the site fails (comma-separated; empty = none)
ERROR_EMAILS=
# Where errors.log and security.log are written (default: the logs folder of the project)
# LOG_DIR=/var/log/mahay

# Payment: sandbox (no real money) or live (needs a real merchant id)
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# SMS: console (terminal) | disabled (no verification) | a provider name when bought
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER=