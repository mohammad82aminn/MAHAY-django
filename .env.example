# Copy this file to .env and fill in real values. Never commit .env.

# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=mahay_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (optional in development; emails are printed in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MAHAY <noreply@mahay.local>

# Payment: sandbox (no real money) or live (needs a real merchant id)
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# SMS: console (terminal) | disabled (no verification) | a provider name when bought
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER=